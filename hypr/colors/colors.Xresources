! X colors.
! Generated by 'wal'
*foreground:        #c3c6c7
*background:        #101c21
*.foreground:       #c3c6c7
*.background:       #101c21
emacs*foreground:   #c3c6c7
emacs*background:   #101c21
URxvt*foreground:   #c3c6c7
XTerm*foreground:   #c3c6c7
UXTerm*foreground:  #c3c6c7
URxvt*background:   [100]#101c21
XTerm*background:   #101c21
UXTerm*background:  #101c21
URxvt*cursorColor:  #c3c6c7
XTerm*cursorColor:  #c3c6c7
UXTerm*cursorColor: #c3c6c7
URxvt*borderColor:  [100]#101c21

! Colors 0-15.
*.color0: #101c21
*color0:  #101c21
*.color1: #91545F
*color1:  #91545F
*.color2: #A95A66
*color2:  #A95A66
*.color3: #BE616B
*color3:  #BE616B
*.color4: #C15F6C
*color4:  #C15F6C
*.color5: #C4656C
*color5:  #C4656C
*.color6: #CF886F
*color6:  #CF886F
*.color7: #c3c6c7
*color7:  #c3c6c7
*.color8: #5e6d72
*color8:  #5e6d72
*.color9: #91545F
*color9:  #91545F
*.color10: #A95A66
*color10:  #A95A66
*.color11: #BE616B
*color11:  #BE616B
*.color12: #C15F6C
*color12:  #C15F6C
*.color13: #C4656C
*color13:  #C4656C
*.color14: #CF886F
*color14:  #CF886F
*.color15: #c3c6c7
*color15:  #c3c6c7

! Black color that will not be affected by bold highlighting.
*.color66: #101c21
*color66:  #101c21

! Xclock colors.
XClock*foreground: #c3c6c7
XClock*background: #101c21
XClock*majorColor:  rgba:c3/c6/c7/ff
XClock*minorColor:  rgba:c3/c6/c7/ff
XClock*hourColor:   rgba:c3/c6/c7/ff
XClock*minuteColor: rgba:c3/c6/c7/ff
XClock*secondColor: rgba:c3/c6/c7/ff

! Set depth to make transparency work.
URxvt*depth: 32
