{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#101c2190",
                "editor.background": "#101c2190",
                "editor.foreground": "#c3c6c7",
                "text": "#c3c6c7",
                "text.muted": "#c3c6c770",
                "text.ignored": "#c3c6c740",
                "text.placeholder": "#c3c6c750",
                "ignored": "#c3c6c730",
                "element.hover": "#c3c6c730",
                "ghost_element.hover": "#91545F30",
                "ghost_element.selected": "#91545F30",
                "ghost_element.active": "#91545F60",
                "border": "#101c21",
                "editor.highlighted_line.background": "#91545F10",
                "editor.active_line.background": "#91545F10",
                "panel.background": "#101c2190",
                "title_bar.background": "#101c2190",
                "title_bar.inactive_background": "#101c2190",
                "status_bar.background": "#101c2190",
                "drop_target.background": "#101c2190",
                "elevated_surface.background": "#101c21",
                "toolbar.background": "#101c2190",
                "tab_bar.background": "#101c2190",
                "tab.inactive_background": "#101c2190",
                "tab.active_background": "#91545F30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#101c21",
                "scrollbar.thumb.background": "#91545F",
                "editor.gutter.background": "#101c2190",
                "terminal.background": "#101c2110",
                "terminal.foreground": "#c3c6c7",
                "terminal.dim_foreground": "#c3c6c7",
                "terminal.bright_foreground": "#c3c6c7",
                "terminal.ansi.black": "#101c21",
                "terminal.ansi.red": "#91545F",
                "terminal.ansi.green": "#A95A66",
                "terminal.ansi.yellow": "#BE616B",
                "terminal.ansi.blue": "#C15F6C",
                "terminal.ansi.magenta": "#C4656C",
                "terminal.ansi.cyan": "#CF886F",
                "terminal.ansi.white": "#c3c6c7",
                "terminal.ansi.bright_black": "#5e6d72",
                "terminal.ansi.bright_red": "#91545F",
                "terminal.ansi.bright_green": "#A95A66",
                "terminal.ansi.bright_yellow": "#BE616B",
                "terminal.ansi.bright_blue": "#C15F6C",
                "terminal.ansi.bright_magenta": "#C4656C",
                "terminal.ansi.bright_cyan": "#CF886F",
                "terminal.ansi.bright_white": "#c3c6c7",
                "modified": "#91545F",
                "syntax": {
                    "attribute": {
                        "color": "#91545F"
                    },
                    "boolean": {
                      "color": "#A95A66"
                    },
                    "comment": {
                      "color": "#5e6d72"
                    },
                    "comment.doc": {
                      "color": "#5e6d72"
                    },
                    "constant": {
                      "color": "#A95A66"
                    },
                    "function": {
                      "color": "#CF886F"
                    },
                    "keyword": {
                      "color": "#C15F6C"
                    },
                    "number": {
                      "color": "#C4656C"
                    },
                    "operator": {
                      "color": "#C15F6C"
                    },
                    "string": {
                      "color": "#91545F"
                    },
                    "variable": {
                      "color": "#A95A66"
                    }
                },
                "players": [
                  {
                    "cursor": "#91545F",
                    "background": "#101c21",
                    "selection": "#91545F30"
                  }
                ]
            }
        }
    ]
}
